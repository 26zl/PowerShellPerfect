# Editor settings matching .gitattributes and the CI checks (ASCII .ps1 files without BOM, CRLF for PowerShell, LF elsewhere).
root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{ps1,psm1,psd1}]
end_of_line = crlf

[*.{json,md,yml,yaml}]
end_of_line = lf
indent_size = 2

[*.md]
trim_trailing_whitespace = false
